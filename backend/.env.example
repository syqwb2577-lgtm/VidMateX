# VidMateX resolver backend — copy to .env and fill in. No real secrets here.

# Optional shared-secret auth. If empty, auth is disabled (anyone can call).
# Set to a long random string and configure the same value in the Android app
# (Settings -> Resolver API key).
RESOLVER_API_KEY=

# Port the HTTP server listens on (behind a TLS reverse proxy in production).
PORT=8000

# Comma-separated list of allowed CORS origins. The Android app is native and
# does not use CORS; set this if you also call the API from a browser.
# Example: https://my-app.example.com,https://admin.example.com
ALLOWED_ORIGINS=

# SSRF / outbound request tuning.
MAX_REDIRECTS=5
MAX_RESPONSE_BYTES=26214400
# Optional policy: set to 1 to reject plain http:// upstream URLs (only
# https:// outbound requests allowed). Leave empty/0 for compatibility with
# older http media origins.
REQUIRE_HTTPS_UPSTREAM=
# DNS-rebinding mitigation: 1 (default) pins connect-time resolution to the
# IPs validated at check time; 0 disables. On the uvloop event loop the Python
# patch is a no-op, so also enforce an egress firewall there (see README §10).
SSRF_PIN_DNS=1

# Rate limit per IP per minute on /extract and /subtitle. Set to 0 to disable.
RATE_LIMIT_PER_MINUTE=30

# Maximum request body size in bytes (request bodies are tiny JSON).
MAX_REQUEST_BYTES=65536

# OPTIONAL opt-in yt-dlp wrapper. DISABLED BY DEFAULT. If set to the path of a
# yt-dlp executable, platform resolvers (YouTube/Facebook/TikTok) will use it to
# obtain real download formats. Enabling this is YOUR responsibility regarding
# platform Terms of Service. The input URL is always SSRF-validated first.
YTDLP_PATH=

# Timeout for yt-dlp invocations (seconds). Only used if YTDLP_PATH is set.
YTDLP_TIMEOUT=60

# --- Android app-side settings (NOT read by this backend process) ---
# These document the matching fields entered in the app's Settings screen.
# Leave empty here; the app stores them encrypted at rest (Android Keystore).
# Resolver backend URL shown in the app (must be an https:// URL ending in /).
BACKEND_BASE_URL=
# Whisper OpenAI-compatible transcription endpoint (e.g. https://host/v1/).
WHISPER_ENDPOINT=
# Optional Whisper provider API key (sent as Authorization: Bearer over HTTPS).
WHISPER_API_KEY=
# Optional LibreTranslate base URL for subtitle translation.
LIBRE_TRANSLATE_BASE_URL=
