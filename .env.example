# VidMateX — root environment example.
#
# IMPORTANT: The Android app does NOT read this file. All Android-side
# configuration (resolver endpoint, resolver API key, Whisper endpoint,
# Whisper API key, LibreTranslate endpoint) is entered in the app's
# Settings screen and stored locally on the device via DataStore
# Preferences. No keys are hardcoded or shipped with the app.
#
# This file documents the environment variables used by the OPTIONAL
# self-hosted resolver backend (backend/). Copy backend/.env.example to
# backend/.env and fill it in when deploying the backend. The full
# reference is backend/.env.example; the essentials are repeated here.

# --- Optional self-hosted resolver backend (backend/) ---
# Shared-secret auth for the resolver API. If empty, auth is disabled.
# Set to a long random string; enter the SAME value in the Android app
# under Settings -> Resolver API key.
RESOLVER_API_KEY=

# Port the resolver HTTP server listens on (behind a TLS reverse proxy
# in production — the Android app enforces https:// for the backend).
PORT=8000

# Comma-separated allowed CORS origins (native Android app does not use
# CORS; set only if you also call the API from a browser).
ALLOWED_ORIGINS=

# SSRF / outbound request tuning.
MAX_REDIRECTS=5
MAX_RESPONSE_BYTES=26214400
# Optional policy: set to 1 to reject plain http:// upstream URLs (only
# https:// outbound requests allowed). Leave empty/0 for compatibility with
# older http media origins. Read by backend/app/ssrf_guard.py.
REQUIRE_HTTPS_UPSTREAM=
# DNS-rebinding mitigation: 1 (default) pins connect-time resolution to the IPs
# validated at check time; 0 disables. On the uvloop event loop the Python
# patch is a no-op, so also enforce an egress firewall. Read by
# backend/app/ssrf_guard.py.
SSRF_PIN_DNS=1

# Per-IP rate limit per minute on /extract and /subtitle (0 = disable).
RATE_LIMIT_PER_MINUTE=30

# Maximum request body size in bytes (request bodies are tiny JSON).
MAX_REQUEST_BYTES=65536

# OPTIONAL opt-in yt-dlp wrapper. DISABLED BY DEFAULT. If set to the path
# of a yt-dlp executable, platform resolvers (YouTube/Facebook/TikTok)
# will use it to obtain real download formats. Enabling this is YOUR
# responsibility regarding platform Terms of Service. The input URL is
# always SSRF-validated first. yt-dlp is NOT in requirements.txt.
YTDLP_PATH=
YTDLP_TIMEOUT=60

# --- Android app (configured in-app Settings UI; these lines document the
# keys, the app itself does NOT read this file). Values are empty placeholders.
# Enter them on the device; secrets are encrypted at rest (Android Keystore).
# Resolver backend base URL (app field "Resolver server URL"; the backend
# process itself reads RESOLVER_API_KEY below, not this file).
BACKEND_BASE_URL=
# Resolver shared-secret in the app UI mirrors backend RESOLVER_API_KEY.
# Whisper OpenAI-compatible endpoint and optional API key (app Settings).
WHISPER_ENDPOINT=
WHISPER_API_KEY=
# LibreTranslate base URL when the LibreTranslate provider is selected (app Settings).
LIBRE_TRANSLATE_BASE_URL=

# No real secrets belong in this file. Never commit a filled-in .env.
# Example secret value must look like: a long random string generated locally,
# e.g. via `openssl rand -hex 32` — do NOT paste such a value here.
